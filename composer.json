{
    "name": "mcf/framework",
    "description": "MCF (Modular Control Framework) for Laravel.",
    "type": "library",
    "license": "MIT",

    "keywords": [
        "laravel",
        "framework",
        "mcf",
        "modular",
        "workflow",
        "generator"
    ],

    "authors": [
        {
            "name": "Abdullah Tech",
            "email": "abdullah.omar.tech.7@gmail.com"
        }
    ],

    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0"
    },

    "require-dev": {
        "laravel/pint": "^1.24",
        "phpunit/phpunit": "^12.0"
    },

    "autoload": {
        "psr-4": {
            "MCF\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "MCF\\Tests\\": "tests/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "MCF\\MCFServiceProvider"
            ]
        }
    },

    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },

    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}