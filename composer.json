{
    "name": "mcf/laravel",
    "description": "MCF (Modular Control Framework) for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "framework",
        "mcf",
        "modular",
        "workflow",
        "generator"
    ],
    "authors": [
        {
            "name": "Abdullah Tech",
            "email": "abdullah.omar.tech.7@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/fortify": "^1.37"
    },
    "autoload": {
        "psr-4": {
            "MCF\\": "src/"
        },
        "exclude-from-classmap": [
            "/src/mcf_laravel/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MCF\\MCFServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}